# Copy to `.env.local` and edit. `.env*` is gitignored except this file.
#
# Nothing here is required — the atlas builds and runs with no env file at all.
# These are opt-in switches.

# Show the DM tools (build report panel and its route) in a build.
# Dev already enables them; set this to surface them in a built preview.
# NEVER set this for a player build — see src/atlas/dmTools.ts.
VITE_ENABLE_DM_TOOLS=false

# --- Build-time only (set inline on the command line, not in a .env file) ---
#
# ATLAS_BASE     Public path for GitHub Pages project sites, e.g. /campaign-atlas/
#                Defaults to "/". The publish workflow sets this automatically.
# INCLUDE_EDITOR "true" forces the DM editor into a build. The player build
#                tree-shakes the editor out, so never set this when publishing.
