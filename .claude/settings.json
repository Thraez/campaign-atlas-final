{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "Edit(./node_modules/**)",
      "Edit(./dist/**)",
      "Edit(./dist-ssr/**)",
      "Edit(./coverage/**)",
      "Edit(./package-lock.json)",
      "Read(./.env)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./.atlas-backups/**)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)"
    ],
    "ask": [
      "PowerShell(git push:*)",
      "Bash(npm run atlas:publish:*)",
      "PowerShell(npm run atlas:publish:*)",
      "Bash(gh workflow run:*)",
      "PowerShell(gh workflow run:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated-paths.mjs\""
          }
        ]
      }
    ]
  }
}
